<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lang"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/pill"
                android:contentDescription="@string/language"
                android:drawableStart="@drawable/ic_language"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/green_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Body"
                android:text="@string/tagline"
                android:textSize="17sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plant_label"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/plant"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_outline"
                android:paddingStart="8dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/camera"
                style="@style/Primary"
                android:drawableStart="@drawable/ic_camera"
                android:text="@string/take_photo"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/gallery"
                style="@style/Outline"
                android:drawableStart="@drawable/ic_gallery"
                android:text="@string/pick_photo" />

            <TextView
                android:id="@+id/supported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:textColor="@color/green"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/dashboard_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/stat_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/stat_scans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_scans"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/stat_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/stat_healthy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_healthy"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/warn_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/stat_care"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/care"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_care"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            style="@style/Body"
            android:text="@string/no_scans"
            android:textColor="@color/muted"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top_issue"
                style="@style/Body"
                android:background="@drawable/warn_bg"
                android:padding="14dp"
                android:textColor="@color/care"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/by_plant"
                style="@style/Card">

                <TextView
                    style="@style/Section"
                    android:text="@string/by_plant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recent"
                style="@style/Card">

                <TextView
                    style="@style/Section"
                    android:text="@string/recent" />
            </LinearLayout>

            <TextView
                android:id="@+id/clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/clear_history"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
